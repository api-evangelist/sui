        {
          "id": "b77a8687-2821-46ed-bb74-f23345e4e3af",
          "name": "unsafe_paySui",
          "request": {
            "name": "unsafe_paySui",
            "description": {
              "content": "Send SUI coins to a list of addresses, following a list of amounts. This is for SUI coin only and does not require a separate gas coin object. Specifically, what pay_sui does are: 1. debit each input_coin to create new coin following the order of amounts and assign it to the corresponding recipient. 2. accumulate all residual SUI from input coins left and deposit all SUI to the first input coin, then use the first input coin as the gas coin object. 3. the balance of the first input coin after tx is sum(input_coins) - sum(amounts) - actual_gas_cost 4. all other input coins other than the first one are deleted.",
              "type": "text/plain"
            },
